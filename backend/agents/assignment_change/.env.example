# Authorization Key из проекта GigaChat API; настоящее значение не коммитить.
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=GigaChat-2
# Путь к корневому сертификату НУЦ Минцифры, если его нет в системном хранилище.
GIGACHAT_CA_BUNDLE_FILE=
# Необязательно: другой адрес Chat Completions, если он отличается от значения по умолчанию.
GIGACHAT_CHAT_URL=

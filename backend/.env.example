# Shared by API and bot. Apply backend/migrate.py before startup.
USITY_DATABASE_URL=sqlite:///./usity-demo.sqlite3

# API email login. Set a stable random secret (32 bytes minimum) and SMTP/TLS.
USITY_AUTH_SECRET=
USITY_SMTP_HOST=
USITY_SMTP_PORT=465
USITY_SMTP_FROM=
USITY_SMTP_USER=
USITY_SMTP_PASSWORD=

# Bot process only. Keep real values in local environment, never in Git.
USITY_TELEGRAM_BOT_TOKEN=
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_CA_BUNDLE_FILE=
